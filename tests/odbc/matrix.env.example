# Copy to tests/odbc/matrix.env (gitignored) and adjust; run-matrix.sh sources
# it. Anything already set in the environment takes precedence.

# Host running the container tiers (11g, 18c, 21c, 23ai, 26ai, 10g).
SEER_CONTAINER_HOST=192.0.2.10

# Oracle 9i VM (leave unset to skip the 9i tier).
SEER_9I_HOST=192.0.2.20

# Oracle 8i VM (leave unset to skip the 8i tier); its bed account is often
# SYSTEM rather than the default user.
SEER_8I_HOST=192.0.2.30
#SEER_8I_USER=system
#SEER_8I_PASS=manager

# Default account on every tier.
SEER_MATRIX_USER=pyo
SEER_MATRIX_PASS=pyo123

# Per-tier overrides: SEER_<TIER>_{HOST,PORT,TARGET,USER,PASS}
#SEER_23AI_USER=system
#SEER_23AI_PASS=oracle123

# Tiers to leave out by default (comma or space separated).
#SEER_MATRIX_SKIP=26ai
